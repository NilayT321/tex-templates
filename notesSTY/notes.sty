\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\RequirePackage{tcolorbox}
\RequirePackage{setspace}
\RequirePackage{import}
\RequirePackage{pdfpages}
\RequirePackage{svg}
\RequirePackage{transparent}
